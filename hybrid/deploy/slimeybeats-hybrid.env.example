# Source example only. The server agent creates /etc/slimeybeats-hybrid/environment
# as root:root 0600. Do not source this file in a shell or put it in a web build.
# Deliberately too short: backend startup must reject this until replaced.
SLIMEYBEATS_HYBRID_TOKEN=REPLACE_ME
SLIMEYBEATS_HYBRID_ORIGINS=https://slimedragonair.github.io
SLIMEYBEATS_HYBRID_CLI=/opt/slimeybeats-hybrid/repository/rust/target/release/slimeybeats-ez-master-cli
SLIMEYBEATS_HYBRID_STORAGE=/var/lib/slimeybeats-hybrid
